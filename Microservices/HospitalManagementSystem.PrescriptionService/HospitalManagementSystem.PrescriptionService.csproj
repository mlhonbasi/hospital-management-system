    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>7b944dfa-719b-4d7d-9a4d-6848cbe31a1c</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AutoMapper" Version="13.0.1" />
